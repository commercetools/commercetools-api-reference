#%RAML 1.0 DataType
(package): Configuration
type: Provider
discriminatorValue: DynatraceSaaS
properties:
  environmentId:
    type: string
    description: |
      Unique user-defined environment identifier of your DynatraceSaaS account.
example:
  {
    'type': 'DynatraceSaaS',
    'active': true,
    'environmentId': 'dtMyEnvironment',
    'eventTypes': ['Metrics'],
  }
