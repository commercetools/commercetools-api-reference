#%RAML 1.0 DataType
(package): Configuration
type: Provider
discriminatorValue: NewRelic
properties:
  region:
    type: NewRelicRegion
    description: |
      Region where your NewRelic account is hosted. For example, EU.
example:
  {
    'type': 'NewRelic',
    'active': true,
    'region': 'eu',
    'eventTypes': ['Metrics'],
  }
