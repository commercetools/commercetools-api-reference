#%RAML 1.0 DataType
(package): Configuration
type: object
displayName: ProjectConfigurationDraft
properties:
  active?:
    type: boolean
    description: |
      Whether the Platform Insights configuration for your Project is active.
  providers:
    type: ProviderDraft[]
    maxItems: 5
    description: |
      List of supported APM providers.
    (uniqueProperty): 'type'
  additionalAttributes?:
    type: AttributeDraft[]
    maxItems: 10
    (uniqueProperty): 'name'
    description: |
      List of Attributes to add to a metric.
example:
  {
    'providers':
      [
        {
          'type': 'NewRelic',
          'eventTypes': ['Metrics'],
          'region': 'eu',
          'apiKey': 'euNR12345',
        },
      ],
  }
description: |
  Draft to create a Platform Insights configuration for your Project.
