#%RAML 1.0 DataType
(package): Configuration
type: object
discriminator: type
properties:
  type: ProviderTypeId
  active:
    type: boolean
    description: |
      Whether this provider configuration is active.
  valid?:
    type: boolean
    description: |
      Whether it's possible to send metrics to the APM provider.
  eventTypes:
    type: EventType[]
    description: |
      List of event types to be exported to a supported APM provider.
