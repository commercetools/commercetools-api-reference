#%RAML 1.0 DataType
(package): Configuration
type: Provider
discriminatorValue: Datadog
properties:
  site:
    type: DatadogSite
    description: |
      Website where your Datadog account is hosted.
example:
  {
    'type': 'Datadog',
    'active': true,
    'site': 'US1',
    'eventTypes': ['Metrics'],
  }
