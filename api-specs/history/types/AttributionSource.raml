#%RAML 1.0 DataType
(package): ChangeHistory
type: string
displayName: AttributionSource
enum:
  - Import
  - Export
  - IntakeAgent
  - PromotionsAgent
  - ManagedCommerceMCP
  - ProductEnrichmentAgent
description: Indicates the source that indirectly made the change. This is a variant of [AttributionSource](ctp:api:type:AttributionSource).
(enumDescriptions):
  Import: The change was made during an import.
  Export: The change was made during an export.
  IntakeAgent: The change was made by the Intake Agent.
  PromotionsAgent: The change was made by the Promotions Agent.
  ManagedCommerceMCP: The change was made through the Managed Commerce MCP.
  ProductEnrichmentAgent: The change was made by the Product Enrichment Agent. This value is available in early access.
