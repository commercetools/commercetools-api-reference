#%RAML 1.0 DataType
(annotations.package): Deployment
type: object
displayName: DeploymentRevision
description: |
  A previously deployed configuration of a [Deployment](ctp:connect:type:Deployment).
example: !include ../../examples/deployment/revision.json
properties:
  revisionNumber:
    type: number
    format: int64
    description: Version of the Deployment this revision was taken from.
  currentRevision:
    type: boolean
    description: Whether this revision is the current version of the Deployment.
  connector:
    type: common.DeploymentRevisionConnector
    description: Identity, version, and source repository of the Connector that was deployed.
  globalConfiguration?:
    type: common.DeploymentGlobalConfiguration
    description: Global configuration applied to all applications at this revision.
  applications:
    type: common.DeploymentRevisionApplication[]
    description: Configuration of each application at this revision.
  rollbackRevision?:
    type: number
    format: int64
    description: |
      The revision this one restored. Only present when the revision was itself produced by a rollback.
  createdAt:
    type: datetime
    description: Date and time (UTC) the revision was created.
