#%RAML 1.0 DataType
(annotations.package): Deployment
type: object
displayName: DeploymentRollback
description: |
  Body of a rollback request. The revision to restore is given in the request path, so the body only carries the concurrency check.
example: !include ../../examples/deployment/rollback.json
properties:
  version:
    type: number
    format: int64
    description: |
      Expected version of the Deployment on which the changes apply.
