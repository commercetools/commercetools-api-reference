#%RAML 1.0 DataType
(annotations.package): error
type: ErrorObject
displayName: DeploymentRollbackNotAllowedError
discriminatorValue: DeploymentRollbackNotAllowed
description: |
  Returned when the target revision cannot be applied to the current Deployment.

  The error is returned as a failed response to a Rollback DeploymentRevision request.
properties:
  code:
    type: string
  message:
    type: string
    description: Identifies the reason why the rollback is not allowed.
