base:
  get?:
    displayName: Query <<resourcePathName>>
    responses:
      200:
  post?:
    displayName: Create <<resourceType | !singularize>>
    responses:
      201:
baseByParam:
  type: base
  uriParameters:
    <<uriParameterName>>:
      description: |
        `<<uriParameterName | !lowercamelcase>>` of the <<resourceType | !singularize>>
      type: string
  get?:
    displayName: Get <<resourceType | !singularize>> by <<uriParameterName | !lowercamelcase>>
    responses:
      200:
        description: The requested  <<resourceType | !singularize>> was found.
      404:
        description: The requested <<resourceType | !singularize>> wasn't found.
        body:
          type: ErrorResponse
          example: !include ../examples/error/not-found.json
  post?:
    displayName: Update <<resourceType | !singularize>> by <<uriParameterName | !lowercamelcase>>
    responses:
      201:
        description: The  <<resourceType | !singularize>> was successfully updated.
      404:
        description: The requested connector wasn't found.
        body:
          type: ErrorResponse
          example: !include ../examples/error/not-found.json
  delete?:
    displayName: Delete <<resourceType | !singularize>>  by <<uriParameterName | !lowercamelcase>>
    responses:
      200:
        body:
          type: Deployment
connectorByParam:
  type: baseByParam
  delete:
    is:
      - secured_by_manage_connectors
    responses:
      200:
        body:
          type: ConnectorStaged
          example: !include ../examples/connector/staged.json
      404:
        description: Connector not found.
      400:
        description: The request was invalid.
        body:
          type: ErrorResponse
  get:
    is:
      - secured_by_view_connectors
    responses:
      200:
        body:
          type: ConnectorStaged
          example: !include ../examples/connector/staged.json
  post:
    is:
      - secured_by_manage_connectors
    body:
      type: ConnectorUpdate
      example: !include ../examples/connector/update.json
    responses:
      201:
        body:
          type: ConnectorStaged
          example: !include ../examples/connector/updated-draft.json
deploymentByParam:
  type: baseByParam
  get:
    is:
      - secured_by_view_connectors_deployments
    responses:
      200:
        body:
          type: Deployment
          example: !include ../examples/deployment/minimal.json
  post:
    is:
      - secured_by_manage_connectors_deployments
    body:
      type: DeploymentUpdate
      example: !include ../examples/deployment/update.json
    responses:
      201:
        body:
          type: Deployment
          example: !include ../examples/deployment/minimal.json
  delete:
    is:
      - secured_by_manage_connectors_deployments
    responses:
      202:
        body:
          type: Deployment
          example: !include ../examples/deployment/minimal.json
deploymentRevisions:
  get:
    description: |
      Retrieves the revisions of a Deployment, most recent first.

      Only versions that were deployed successfully are returned, so every result is a valid rollback target.
      At most 20 revisions are returned.
    is:
      - secured_by_view_connectors_deployments
    responses:
      200:
        body:
          type: array
          items: DeploymentRevision
          example: !include ../examples/deployment/revisions.json
deploymentRevisionByParam:
  uriParameters:
    revision:
      description: |
        `revisionNumber` of the DeploymentRevision.
      type: number
      format: int64
      minimum: 1
  get:
    is:
      - secured_by_view_connectors_deployments
    responses:
      200:
        description: The requested DeploymentRevision was found.
        body:
          type: DeploymentRevision
          example: !include ../examples/deployment/revision.json
      404:
        description: The requested DeploymentRevision wasn't found.
        body:
          type: ErrorResponse
          example: !include ../examples/error/not-found.json
deploymentRollback:
  post:
    description: |
      Restores the configuration of the revision onto the Deployment.
      A new Deployment version is created from the revision and deployed.

      The `manage_api_clients:{projectKey}` scope is required if the connector version uses commercetools managed API Client credentials.

      Specific Error Codes:
      - [DeploymentRollbackNotAllowed](ctp:connect:type:DeploymentRollbackNotAllowedError)
      - [DeploymentInvalidStatusTransition](ctp:connect:type:DeploymentInvalidStatusTransitionError)
      - [ConcurrentModification](ctp:connect:type:ConcurrentModificationError)
    is:
      - secured_by_manage_connectors_deployments
    body:
      type: DeploymentRollback
      example: !include ../examples/deployment/rollback.json
    responses:
      202:
        description: The rollback was accepted and the Deployment was queued.
        body:
          type: Deployment
          example: !include ../examples/deployment/minimal.json
      404:
        description: The requested Deployment or DeploymentRevision wasn't found.
        body:
          type: ErrorResponse
          example: !include ../examples/error/not-found.json
deploymentLogs:
  type: base
  get:
    description: Retrieves logs for the given deployment.
    is:
      - secured_by_view_connectors_deployments
    queryParameters:
      pageToken?:
        type: string
      applicationName?:
        type: string
        description: Filter results by a specific `applicationName`.
      startDate?:
        type: datetime
        description: Filter results by defining a start date. This value can be up to 30 days in the past.
      endDate?:
        type: datetime
        description: Filter results by defining an end date of the logs.
    responses:
      200:
        body:
          type: DeploymentLogCursorPagedQueryResponse
          properties:
            data: DeploymentLog[]
          example: !include ../examples/deployment-log/cursor-paged.json
