{
  "applicationName": "event-application",
  "standardConfiguration": [
    {
      "key": "CONFIG_KEY",
      "value": "config key value"
    }
  ],
  "securedConfiguration": [
    {
      "key": "CONFIG_SECRET",
      "value": "********"
    }
  ],
  "retryPolicy": {
    "strategy": "exponential-backoff",
    "minBackoffSeconds": 10,
    "maxBackoffSeconds": 120,
    "maxAttempts": 10
  }
}