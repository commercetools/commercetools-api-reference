#%RAML 1.0 DataType
(package): Me
type: MyCartUpdateAction
displayName: MyCartSetLocaleAction
discriminatorValue: setLocale
example: !include ../../../examples/Cart/CartSetLocaleAction.json
properties:
  locale?:
    type: Locale
    description: |
      Value to set.
      Must be one of the [Project](ctp:api:type:Project)'s `languages`.
      If omitted, any existing value is removed.
