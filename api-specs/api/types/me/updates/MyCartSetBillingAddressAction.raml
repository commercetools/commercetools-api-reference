#%RAML 1.0 DataType
(package): Me
type: MyCartUpdateAction
displayName: MyCartSetBillingAddressAction
discriminatorValue: setBillingAddress
example: !include ../../../examples/Cart/CartSetBillingAddressAction.json
properties:
  address?:
    type: BaseAddress
    description: |
      Value to set. It replaces the entire address, including [Custom Fields](ctp:api:type:CustomFields) if `custom` is not included. To preserve Custom Fields, include the `custom` object in the request.

      If omitted, any existing value is removed.
