#%RAML 1.0 DataType
(package): DiscountCode
type: DiscountCodeUpdateAction
displayName: DiscountCodeSetKeyAction
discriminatorValue: setKey
example: !include ../../../examples/DiscountCode/DiscountCodeSetKeyAction.json
description: |
  This action generates a [DiscountCodeKeySet](ctp:api:type:DiscountCodeKeySetMessage) Message.
properties:
  key?:
    type: string
    description: |
      Value to set. If omitted, any existing value is removed.

      If the value is used by another Discount Code, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
