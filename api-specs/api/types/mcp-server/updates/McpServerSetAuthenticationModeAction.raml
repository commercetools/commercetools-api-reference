#%RAML 1.0 DataType
(package): McpServer
type: McpServerUpdateAction
displayName: McpServerSetAuthenticationModeAction
discriminatorValue: setAuthenticationMode
example: !include ../../../examples/McpServer/McpServerSetAuthenticationModeAction.json
description: |
  Sets the [authentication mode](ctp:api:type:McpServerAuthenticationMode) of the MCP Server. This action has no effect if the MCP Server already uses the given authentication mode, and in that case the `version` of the MCP Server stays the same.
properties:
  authenticationMode:
    type: McpServerAuthenticationMode
    description: |
      New authentication mode to set.
