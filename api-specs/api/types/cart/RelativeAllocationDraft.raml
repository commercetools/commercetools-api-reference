#%RAML 1.0 DataType
(package): Cart
type: AllocationDraft
(beta): true
displayName: RelativeAllocationDraft
discriminatorValue: Relative
example: !include ../../examples/Cart/RelativeAllocationDraft.json
description: |
  Allocates a percentage of the Order total to a Payment Method.
properties:
  percentage:
    type: number
    format: int32
    minimum: 1
    maximum: 100
    description: |
      Percentage of the Order total allocated to the Payment Method. For example, `100` allocates the entire Order total.
