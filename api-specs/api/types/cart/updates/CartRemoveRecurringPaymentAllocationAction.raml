#%RAML 1.0 DataType
(package): Cart
type: CartUpdateAction
(beta): true
displayName: CartRemoveRecurringPaymentAllocationAction
discriminatorValue: removeRecurringPaymentAllocation
example: !include ../../../examples/Cart/CartRemoveRecurringPaymentAllocationAction.json
description: |
  Removes a [RecurringPaymentAllocation](ctp:api:type:RecurringPaymentAllocation) from the `paymentAllocations` of the [RecurringPaymentConfiguration](ctp:api:type:RecurringPaymentConfiguration).
properties:
  id:
    type: string
    description: |
      `id` of the [RecurringPaymentAllocation](ctp:api:type:RecurringPaymentAllocation) to remove.
