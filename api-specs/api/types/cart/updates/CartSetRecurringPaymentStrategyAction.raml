#%RAML 1.0 DataType
(package): Cart
type: CartUpdateAction
(beta): true
displayName: CartSetRecurringPaymentStrategyAction
discriminatorValue: setRecurringPaymentStrategy
example: !include ../../../examples/Cart/CartSetRecurringPaymentStrategyAction.json
description: |
  Sets the `paymentStrategy` of the [RecurringPaymentConfiguration](ctp:api:type:RecurringPaymentConfiguration) without changing the existing `paymentAllocations`. To set both at once, use the [Set RecurringPaymentConfiguration](ctp:api:type:CartSetRecurringPaymentConfigurationAction) update action.
properties:
  paymentStrategy:
    type: PaymentStrategy
    description: |
      New value to set.
