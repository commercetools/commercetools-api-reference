#%RAML 1.0 DataType
(package): Cart
(beta): true
displayName: PaymentStrategy
type: string
description: |
  Determines how payment for the Orders generated by a [RecurringOrder](ctp:api:type:RecurringOrder) is collected.
enum:
  - Checkout
(enumDescriptions):
  Checkout: |
    Payment is collected by [commercetools Checkout](/checkout/overview) before the Order is created. If the payment fails, no Order is created and the Recurring Order transitions to the `Failed` [RecurringOrderState](ctp:api:type:RecurringOrderState).
