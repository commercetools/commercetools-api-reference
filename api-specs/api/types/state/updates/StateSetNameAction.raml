#%RAML 1.0 DataType
(package): State
type: StateUpdateAction
displayName: StateSetNameAction
discriminatorValue: setName
example: !include ../../../examples/State/StateSetNameAction.json
properties:
  name:
    type: LocalizedString
    description: |
      Value to set.
      If the new value is the same as the current value, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.

      Set to an empty object to remove any existing value.
