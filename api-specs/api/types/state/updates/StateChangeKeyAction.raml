#%RAML 1.0 DataType
(package): State
type: StateUpdateAction
displayName: StateChangeKeyAction
discriminatorValue: changeKey
example: !include ../../../examples/State/StateChangeKeyAction.json
properties:
  key:
    type: string
    description: |
      New value to set.

      If set to an empty value, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.

      If the value is used by another State in the Project, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
