#%RAML 1.0 DataType
(package): ShippingMethod
type: ShippingMethodUpdateAction
displayName: ShippingMethodSetCarrierAction
discriminatorValue: setCarrier
example: !include ../../../examples/ShippingMethod/ShippingMethodSetCarrierAction.json
properties:
  carrier?:
    type: string
    description: |-
      Name of the carrier that delivers the parcel, for example `DHL`. If `carrier` is absent or `null`, it is removed if it exists.
