#%RAML 1.0 DataType
(package): ShoppingList
type: ShoppingListUpdateAction
displayName: ShoppingListSetKeyAction
discriminatorValue: setKey
example: !include ../../../examples/ShoppingList/ShoppingListSetKeyAction.json
properties:
  key?:
