#%RAML 1.0 DataType
(package): Channel
type: ChannelUpdateAction
displayName: ChannelChangeKeyAction
discriminatorValue: changeKey
example: !include ../../../examples/Channel/updates/ChannelChangeKeyAction.json
properties:
  key:
    type: string
    description: |
      New value to set.

      If set to an empty value, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.

      If the value is used by another Channel in the Project, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
