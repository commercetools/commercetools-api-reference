#%RAML 1.0 DataType
(package): Channel
type: ChannelUpdateAction
displayName: ChannelSetRolesAction
discriminatorValue: setRoles
example: !include ../../../examples/Channel/ChannelSetRolesAction.json
properties:
  roles:
    type: ChannelRoleEnum[]
    default: ['InventorySupply']
    description: |
      Value to set. If set to an empty array, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.

       If the new value is the same as the current value, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
