#%RAML 1.0 DataType
(package): Channel
type: ChannelUpdateAction
displayName: ChannelAddRolesAction
discriminatorValue: addRoles
example: !include ../../../examples/Channel/ChannelAddRolesAction.json
properties:
  roles:
    type: ChannelRoleEnum[]
    description: |
      Value to append to the array.

      If the specified roles are already present, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
