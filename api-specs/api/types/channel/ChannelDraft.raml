#%RAML 1.0 DataType
(package): Channel
displayName: ChannelDraft
example: !include ../../examples/Channel/ChannelDraft.json
type: object
properties:
  key:
    type: string
    description: |
      User-defined unique identifier for the Channel.

      If set to an empty value, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.

      If the value is used by another Channel in the Project, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
  roles?:
    type: ChannelRoleEnum[]
    default: ['InventorySupply']
    description: |
      Roles of the Channel.

      The Channel must have at least one role. If set to an empty array, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
  name?:
    type: LocalizedString
    description: |
      Name of the Channel.
  description?:
    type: LocalizedString
    description: |
      Description of the Channel.
  address?:
    type: BaseAddress
    description: |
      Address where the Channel is located.
  custom?:
    type: CustomFieldsDraft
    description: |
      Custom fields defined for the Channel.
  geoLocation?:
    type: GeoJson
    description: |
      GeoJSON geometry object encoding the geo location of the Channel.
      Currently, only the [Point](ctp:api:type:GeoJsonPoint) type is supported.
