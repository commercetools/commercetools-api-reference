#%RAML 1.0 DataType
(package): Product
type: ProductUpdateAction
displayName: ProductSetMetaDescriptionAction
discriminatorValue: setMetaDescription
example: !include ../../../examples/Product/ProductSetMetaDescriptionAction.json
properties:
  metaDescription?:
    type: LocalizedString
    description: |
      Value to set. If omitted, any existing value is removed.
  staged?:
    type: boolean
    description: |
      Whether only the staged `metaDescription` is updated. If `false`, both the current and staged `metaDescription` are updated.
    default: true
