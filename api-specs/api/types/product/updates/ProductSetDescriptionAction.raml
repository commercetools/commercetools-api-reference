#%RAML 1.0 DataType
(package): Product
type: ProductUpdateAction
displayName: ProductSetDescriptionAction
discriminatorValue: setDescription
example: !include ../../../examples/Product/ProductSetDescriptionAction.json
properties:
  description?:
    type: LocalizedString
    description: |
      Value to set. If omitted, any existing value is removed.
  staged?:
    type: boolean
    description: |
      Whether only the staged `description` is updated. If `false`, both the current and staged `description` are updated.
    default: true
