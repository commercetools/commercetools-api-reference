#%RAML 1.0 DataType
(package): Agent
type: WarningObject
displayName: AgentFileNotProcessedWarning
discriminatorValue: FileNotProcessed
description: |
  Returned when an uploaded file in an Intake Agent [API request](/api/agents/intake-agent#create-a-cart-or-quote-request) could not be parsed.
example: !include ../../examples/agent/AgentFileNotProcessedWarning.json
properties:
  code:
    type: string
  message:
    type: string
    description: |
      Plain text description of why the file could not be parsed.
  fileName:
    type: string
    description: |
      Name of the file that failed to parse.
