#%RAML 1.0 DataType
(package): Agent
type: ErrorResponse
displayName: AgentResponsesErrorResponse
description: |
  Error response from a [/responses](/api/agents/intake-agent#create-a-cart-or-quote-request) request. Extends [ErrorResponse](ctp:api:type:ErrorResponse) with a `threadId` for support.
example: !include ../../examples/agent/AgentResponsesErrorResponse.json
properties:
  errors:
    type: array
    items: ErrorObject
    minItems: 1
    description: |
      Errors returned for a request.

      A single error response can contain multiple errors if the errors are related to the same HTTP status code such as `400`.
  threadId?:
    type: string
    description: |
      Identifier of the workflow run that raised the error. Present on errors raised once the workflow has started. Absent on errors raised while parsing the request, before the workflow starts.
