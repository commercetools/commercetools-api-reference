#%RAML 1.0 DataType
(package): Agent
type: ErrorObject
displayName: AgentProductsNotFoundError
discriminatorValue: ProductsNotFound
description: |
  Returned by a [/responses](/api/agents/intake-agent#create-a-cart-or-quote-request) request when none of the requested products could be matched to the catalog.
properties:
  code:
    type: string
  message:
    type: string
    description: |
      Plain text description of the error.
