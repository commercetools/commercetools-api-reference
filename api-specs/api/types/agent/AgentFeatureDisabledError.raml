#%RAML 1.0 DataType
(package): Agent
type: ErrorObject
displayName: AgentFeatureDisabledError
discriminatorValue: FeatureDisabled
description: |
  Returned by a [/responses](/api/projects/intake#create-a-cart-quote-request-or-shopping-list) request when Intake is not enabled for the Project.
example: !include ../../examples/agent/AgentFeatureDisabledError.json
properties:
  code:
    type: string
  message:
    type: string
    description: |
      Plain text description of the error.
