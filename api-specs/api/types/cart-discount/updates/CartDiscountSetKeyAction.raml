#%RAML 1.0 DataType
(package): CartDiscount
type: CartDiscountUpdateAction
displayName: CartDiscountSetKeyAction
discriminatorValue: setKey
example: !include ../../../examples/CartDiscount/CartDiscountSetKeyAction.json
properties:
  key?:
    type: string
    description: |
      Value to set. If omitted, any existing value is removed.

      If the value is used by another Cart Discount, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
