#%RAML 1.0 DataType
(package): CartDiscount
type: CartDiscountUpdateAction
displayName: CartDiscountChangeSortOrderAction
discriminatorValue: changeSortOrder
example: !include ../../../examples/CartDiscount/CartDiscountChangeSortOrderAction.json
properties:
  sortOrder:
    type: string
    description: |
      New value to set (between `0` and `1`).
      A Discount with a higher sortOrder is prioritized.

      If the value is used by another Cart Discount or Discount Group, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
