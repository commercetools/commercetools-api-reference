#%RAML 1.0 DataType
(package): Extension
type: ExtensionUpdateAction
displayName: ExtensionSetKeyAction
discriminatorValue: setKey
example: !include ../../../examples/Extension/ExtensionSetKeyAction.json
properties:
  key?:
    type: string
    description: |
      Value to set. If omitted, any existing value is removed.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
