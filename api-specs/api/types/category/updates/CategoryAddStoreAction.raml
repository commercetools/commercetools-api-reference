#%RAML 1.0 DataType
(package): Category
type: CategoryUpdateAction
displayName: CategoryAddStoreAction
discriminatorValue: addStore
(beta): true
example: !include ../../../examples/Category/CategoryAddStoreAction.json
properties:
  store:
    type: StoreResourceIdentifier
    description: |
      Value to add to the Category's `stores`.

      When called through an [in-Store endpoint](#update-category-in-store), the caller must have permission for the referenced [Store](ctp:api:type:Store).
