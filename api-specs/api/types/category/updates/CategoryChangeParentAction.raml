#%RAML 1.0 DataType
(package): Category
type: CategoryUpdateAction
displayName: CategoryChangeParentAction
discriminatorValue: changeParent
example: !include ../../../examples/Category/CategoryChangeParentAction.json
description: |
  This action locks the entire Category tree in the Project for the duration of the request. For details, see [Category tree locking](/api/product-catalog-apis-overview#category-tree-locking).
properties:
  parent:
    type: CategoryResourceIdentifier
    description: |
      New value to set as parent.
