#%RAML 1.0 DataType
(package): ProductDiscount
type: ProductDiscountUpdateAction
displayName: ProductDiscountSetKeyAction
discriminatorValue: setKey
example: !include ../../../examples/ProductDiscount/ProductDiscountSetKeyAction.json
properties:
  key?:
    type: string
    description: |
      Value to set. If omitted, any existing value is removed.

      If the value is used by another Product Discount, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
