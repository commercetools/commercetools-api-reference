#%RAML 1.0 DataType
(package): TaxCategory
type: TaxCategoryUpdateAction
displayName: TaxCategoryChangeNameAction
discriminatorValue: changeName
example: !include ../../../examples/TaxCategory/TaxCategoryChangeNameAction.json
properties:
  name:
    type: string
    description: |
      New value to set.

      If the provided name is used by another TaxCategory in the Project, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
