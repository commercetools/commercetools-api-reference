#%RAML 1.0 DataType
(package): TaxCategory
type: TaxCategoryUpdateAction
displayName: TaxCategoryReplaceTaxRateAction
discriminatorValue: replaceTaxRate
example: !include ../../../examples/TaxCategory/TaxCategoryReplaceTaxRateAction.json
properties:
  taxRateId?:
    type: string
    description: |
      ID of the TaxRate to replace.
      Either `taxRateId` or `taxRateKey` must be provided.

      If the referenced TaxRate does not exist within the TaxCategory, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
  taxRateKey?:
    type: string
    description: |
      Key of the TaxRate to replace.
      Either `taxRateId` or `taxRateKey` must be provided.

      If the referenced TaxRate does not exist within the TaxCategory, an [InvalidOperation](ctp:api:type:InvalidOperationError) error is returned.
  taxRate:
    type: TaxRateDraft
    description: |
      New TaxRate to replace with.
