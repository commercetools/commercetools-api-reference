#%RAML 1.0 DataType
(package): ApiClient
displayName: ApiClient
type: object
example: !include ../../examples/api-client/ApiClient.json
properties:
  id:
    type: string
    description: |-
      The OAuth2 `client_id` that can be used to [obtain an access token](/api/authorization#request-an-access-token-using-the-internal-oauth-20-service).
  name:
    type: string
    description: Name of the APIClient.
  scope:
    type: string
    description: |-
      Whitespace-separated list of [OAuth scopes](/api/scopes) that can be used when [obtaining an access token](/api/authorization#request-an-access-token-using-the-internal-oauth-20-service).
  secret?:
    type: string
    description: |-
      Only shown once in the response of creating the APIClient.
      This is the OAuth2 `client_secret` that can be used to [obtain an access token](/api/authorization#request-an-access-token-using-the-internal-oauth-20-service).
  lastUsedAt?:
    type: date-only
    description: Date of the last day this APIClient was used to [obtain an access token](/api/authorization#request-an-access-token-using-the-internal-oauth-20-service).
  deleteAt?:
    type: datetime
    description:
      If set, the Client will be deleted on (or shortly after) this point in
      time.
  createdAt?:
    type: datetime
    description: Date and time (UTC) the APIClient was initially created.
  accessTokenValiditySeconds?:
    type: number
    format: int32
    minimum: 3600
    maximum: 604800
    description: |
      Expiration time in seconds for each access token obtained by the APIClient. Only present when set with the [APIClientDraft](ctp:api:type:ApiClientDraft). If not present, the default depends on the flow used to obtain the access token.

      - `10 800` seconds (3 hours) for [anonymous sessions](/api/authorization#tokens-for-anonymous-sessions).
      - `172 800` seconds (48 hours) for other flows.

  refreshTokenValiditySeconds?:
    type: number
    format: int32
    minimum: 30
    maximum: 31536000
    default: 17280000
    description: |
      Inactivity expiration time in seconds for each refresh token obtained by the APIClient. Only present when set with the [APIClientDraft](ctp:api:type:ApiClientDraft). If not present the default value applies.
