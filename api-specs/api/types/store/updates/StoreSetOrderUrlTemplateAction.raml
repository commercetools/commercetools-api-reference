#%RAML 1.0 DataType
(package): Store
type: StoreUpdateAction
displayName: StoreSetOrderUrlTemplateAction
discriminatorValue: setOrderUrlTemplate
example: !include ../../../examples/Store/StoreSetOrderUrlTemplateAction.json
description: |
  This update action produces the [StoreOrderUrlTemplateSet](ctp:api:type:StoreOrderUrlTemplateSetMessage) Message.
properties:
  orderUrlTemplate?:
    type: string
    description: |
      Value to set. Must be an [RFC 6570](https://datatracker.ietf.org/doc/html/rfc6570) URI template containing the `orderId` variable.
      If empty, any existing value is removed.
