#%RAML 1.0 DataType
(package): Store
type: StoreUpdateAction
displayName: StoreSetCookiePolicyUrlAction
discriminatorValue: setCookiePolicyUrl
example: !include ../../../examples/Store/StoreSetCookiePolicyUrlAction.json
description: |
  This update action produces the [StoreCookiePolicyUrlSet](ctp:api:type:StoreCookiePolicyUrlSetMessage) Message.
properties:
  cookiePolicyUrl?:
    type: string
    description: |
      Value to set. Must be an absolute `https` URL. If empty, any existing value is removed.
