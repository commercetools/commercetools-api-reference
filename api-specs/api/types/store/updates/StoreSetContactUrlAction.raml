#%RAML 1.0 DataType
(package): Store
type: StoreUpdateAction
displayName: StoreSetContactUrlAction
discriminatorValue: setContactUrl
example: !include ../../../examples/Store/StoreSetContactUrlAction.json
description: |
  This update action produces the [StoreContactUrlSet](ctp:api:type:StoreContactUrlSetMessage) Message.
properties:
  contactUrl?:
    type: string
    description: |
      Value to set. Must be an absolute `https` URL. If empty, any existing value is removed.
