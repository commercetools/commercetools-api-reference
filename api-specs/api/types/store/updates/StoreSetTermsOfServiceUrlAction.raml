#%RAML 1.0 DataType
(package): Store
type: StoreUpdateAction
displayName: StoreSetTermsOfServiceUrlAction
discriminatorValue: setTermsOfServiceUrl
example: !include ../../../examples/Store/StoreSetTermsOfServiceUrlAction.json
description: |
  This update action produces the [StoreTermsOfServiceUrlSet](ctp:api:type:StoreTermsOfServiceUrlSetMessage) Message.
properties:
  termsOfServiceUrl?:
    type: string
    description: |
      Value to set. Must be an absolute `https` URL. If empty, any existing value is removed.
