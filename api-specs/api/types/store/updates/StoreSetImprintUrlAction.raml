#%RAML 1.0 DataType
(package): Store
type: StoreUpdateAction
displayName: StoreSetImprintUrlAction
discriminatorValue: setImprintUrl
example: !include ../../../examples/Store/StoreSetImprintUrlAction.json
description: |
  This update action produces the [StoreImprintUrlSet](ctp:api:type:StoreImprintUrlSetMessage) Message.
properties:
  imprintUrl?:
    type: string
    description: |
      Value to set. Must be an absolute `https` URL. If empty, any existing value is removed.
