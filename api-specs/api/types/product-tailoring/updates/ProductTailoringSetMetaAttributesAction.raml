#%RAML 1.0 DataType
(package): ProductTailoring
type: ProductTailoringUpdateAction
displayName: ProductTailoringSetMetaAttributesAction
discriminatorValue: setMetaAttributes
example: !include ../../../examples/ProductTailoring/ProductTailoringSetMetaAttributesAction.json
description: Updates all meta attributes at the same time.
properties:
  metaTitle?:
    type: LocalizedString
    description: |
      Value to set. If omitted, any existing value is removed.
  metaDescription?:
    type: LocalizedString
    description: |
      Value to set. If omitted, any existing value is removed.
  metaKeywords?:
    type: LocalizedString
    description: |
      Value to set. If omitted, any existing value is removed.
  staged?:
    type: boolean
    description: |
      Whether only the staged attributes are updated. If `false`, both the current and staged attributes are updated.
    default: true
