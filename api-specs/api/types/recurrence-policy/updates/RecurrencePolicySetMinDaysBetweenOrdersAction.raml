#%RAML 1.0 DataType
(package): RecurrencePolicy
type: RecurrencePolicyUpdateAction
displayName: RecurrencePolicySetMinDaysBetweenOrdersAction
discriminatorValue: setMinDaysBetweenOrders
example: !include ../../../examples/RecurrencePolicy/RecurrencePolicySetMinDaysBetweenOrdersAction.json
description: |
  The new value applies immediately to all [Recurring Orders](ctp:api:type:RecurringOrder) that use the RecurrencePolicy.
  It does not affect the recurrence schedule.
properties:
  minDaysBetweenOrders?:
    type: integer
    format: int32
    minimum: 1
    description: |
      Value to set. Must be greater than `0`.
      If omitted, any existing value is removed and there is no limit.
