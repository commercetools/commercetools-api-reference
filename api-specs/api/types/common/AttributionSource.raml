#%RAML 1.0 DataType
(package): Common
displayName: AttributionSource
type: string
enum:
  - Import
  - Export
  - IntakeAgent
  - PromotionsAgent
  - ManagedCommerceMCP
(enumDescriptions):
  Import: Resource was created or updated during import.
  Export: Resource was created or updated during export.
  IntakeAgent: Resource was created or updated by Intake Agent.
  PromotionsAgent: Resource was created or updated by Promotions Agent.
  ManagedCommerceMCP: Resource was created or updated through the Managed Commerce MCP.
