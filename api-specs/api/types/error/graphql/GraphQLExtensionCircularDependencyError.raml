#%RAML 1.0 DataType
(package): Error
type: GraphQLErrorObject
displayName: GraphQLExtensionCircularDependencyError
discriminatorValue: ExtensionCircularDependency
(beta): true
description: |
  Returned when a circular reference is detected among Extension dependencies.

  The `message` lists the `id` of each Extension in the detected cycle, starting and ending with the same Extension.
properties:
  code:
    type: string
