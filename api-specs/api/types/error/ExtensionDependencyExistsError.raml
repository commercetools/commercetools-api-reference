#%RAML 1.0 DataType
(package): Error
type: ErrorObject
displayName: ExtensionDependencyExistsError
discriminatorValue: ExtensionDependencyExists
example: !include ../../examples/Error/ExtensionDependencyExists.json
description: |
  Returned when attempting to delete an Extension that is a prerequisite for other Extensions.
properties:
  code:
    type: string
  message:
    type: string
    description: |
      `"The extension cannot be deleted because it is a prerequisite for: [5e0e1e0b-1f4b-4b8b-9c1a-2d3f4a5b6c7d, 7c9e6679-7425-40de-944b-e07fc1f90ae7]."`
