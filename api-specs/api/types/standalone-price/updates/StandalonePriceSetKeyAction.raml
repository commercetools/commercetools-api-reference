#%RAML 1.0 DataType
(package): StandalonePrice
type: StandalonePriceUpdateAction
displayName: StandalonePriceSetKeyAction
discriminatorValue: setKey
description: |
  Sets the key on a Standalone Price. Produces the [StandalonePriceKeySet](ctp:api:type:StandalonePriceKeySetMessage) Message.
example: !include ../../../examples/StandalonePrice/StandalonePriceSetKeyAction.json
properties:
  key?:
    type: string
    description: |
      Value to set. If omitted, any existing value is removed.

      If the value is used by another Standalone Price, a [DuplicateField](ctp:api:type:DuplicateFieldError) error is returned.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
