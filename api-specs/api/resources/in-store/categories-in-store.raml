      [
        oauth_2_0:
          {
            scopes:
              [
                'view_products:{projectKey}',
                'view_categories:{projectKey}',
                'view_products:{projectKey}:{storeKey}',
                'view_categories:{projectKey}:{storeKey}',
              ],
