#%RAML 1.0 DataType
(annotations.package): Session
type: string
description: Grant used to mint or upgrade a session.
(annotations.enumDescriptions):
  anonymous: An anonymous shopper session.
  password: A signed-in customer session. Merges an anonymous cart when a prior session bearer is sent.
  register: Creates a customer, then mints a signed-in session.
  refresh: Refreshes the sealed commercetools token behind an existing session. Requires a valid session token as bearer.
  idp: Signs in through an external OIDC [identity provider](/commerce-integration-layer/development/identity-providers).
  extension: Signs in through your Project's own [extension](/commerce-integration-layer/development/extension-authentication), which authenticates the shopper and tells the Commerce Integration Layer who they are. Requires the extension to export `onResolveLogin` on its `hooks` object; refused otherwise.
enum:
  - anonymous
  - password
  - register
  - refresh
  - idp
  - extension
