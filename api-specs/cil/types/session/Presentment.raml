#%RAML 1.0 DataType
(annotations.package): Session
type: object
description: |
  Presentment context of a session. If omitted, values fall back to the existing session, and then to the Project's configured defaults.
  A GraphQL query with no resolvable presentment fails with `SESSION_MISSING_PRESENTMENT`.
properties:
  locale?:
    type: string
    description: Locale of the session.
  currency?:
    type: string
    description: Currency of the session.
  country?:
    type: string
    description: Country of the session.
