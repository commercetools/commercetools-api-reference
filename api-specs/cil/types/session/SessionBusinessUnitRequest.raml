#%RAML 1.0 DataType
(annotations.package): Session
type: object
description: Selects the B2B Business Unit and Store of a session.
properties:
  businessUnitKey:
    type: string
    description: Key of the Business Unit to select.
  storeKey:
    type: string
    description: Key of the Store to select. It must be one of the Stores of the Business Unit.
