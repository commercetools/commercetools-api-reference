#%RAML 1.0 DataType
(annotations.package): Session
type: Presentment
description: |
  Request body for `POST /session`. The `grant_type` determines the other fields that apply.
discriminator: grant_type
properties:
  grant_type?:
    type: SessionGrantType
    default: anonymous
    description: Grant to use. Defaults to `anonymous` when omitted.
