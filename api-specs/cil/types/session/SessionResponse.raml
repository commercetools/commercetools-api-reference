#%RAML 1.0 DataType
(annotations.package): Session
type: object
description: |
  Session token to send as the bearer credential for the Experience API (GraphQL).
  The commercetools token sealed inside the session token never leaves the Commerce Integration Layer.
properties:
  token:
    type: string
    description: |
      Opaque signed JWT. Do not decode it or rely on its structure.
  expires_in:
    type: integer
    description: |
      Lifetime of the token in seconds. It depends on how the session was minted, so don't hard-code a value:

      - A session from the `anonymous`, `password`, or `register` grant expires with its sealed commercetools access token, by default 48 hours after it was minted or last refreshed. Updating presentment or selecting a scope reissues the token without extending this.
      - A session from the `idp` grant lasts up to 30 days after it was minted or last refreshed.
  identity:
    type: string
    description: Identity of the shopper, for example `anonymous`.
