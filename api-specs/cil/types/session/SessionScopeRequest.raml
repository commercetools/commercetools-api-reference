#%RAML 1.0 DataType
(annotations.package): Session
type: object
description: |
  Selects the Store and Channels of a session. Provide at least one property. A property that is omitted is left unchanged, and `null` clears it.
properties:
  storeKey?:
    type: string | nil
    description: |
      Key of the Store to select. Pass `null` to leave Store scope, which also clears both Channels unless the same request names them. A session scoped to a Business Unit cannot clear its Store.
  supplyChannelId?:
    type: string | nil
    description: |
      Identifier of the inventory supply Channel to select. The Channel must have the `InventorySupply` role. Pass `null` to clear the selection.
  distributionChannelId?:
    type: string | nil
    description: |
      Identifier of the distribution Channel to select. The Channel must have the `ProductDistribution` role. Pass `null` to clear the selection.
