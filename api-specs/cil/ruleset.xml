<?xml version="1.0" encoding="UTF-8" ?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/commercetools/rmf-codegen/main/ctp-validators/src/main/resources/ruleset.xsd">
    <name>default</name>
    <apply set="default"/>
    <rules>
        <!-- The wire format of the Shopper Identity API uses singular paths, snake_case properties, and lowercase enum values. -->
        <rule>
            <name>com.commercetools.rmf.validators.ResourcePluralRule</name>
            <options>
                <option type="exclude">session</option>
                <option type="exclude">business-unit</option>
                <option type="exclude">distribution-channel</option>
                <option type="exclude">scope</option>
            </options>
        </rule>
        <rule>
            <name>com.commercetools.rmf.validators.CamelCaseRule</name>
            <options>
                <option type="exclude">grant_type</option>
                <option type="exclude">id_token</option>
                <option type="exclude">expires_in</option>
            </options>
        </rule>
        <rule>
            <name>com.commercetools.rmf.validators.EnumValuePascalCaseRule</name>
            <options>
                <!--                   EnumTypeName -->
                <option type="exclude">SessionGrantType</option>
            </options>
        </rule>
        <rule>
            <name>com.commercetools.rmf.validators.UnionTypePropertyRule</name>
            <options>
                <option type="exclude">distributionChannelId</option>
                <option type="exclude">storeKey</option>
                <option type="exclude">supplyChannelId</option>
            </options>
        </rule>
    </rules>
</ruleset>
