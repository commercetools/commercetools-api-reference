#%RAML 1.0
---
title: Checkout API
uses:
  annotations: types/annotations.raml

(annotations.products):
  - Checkout
version: v1
mediaType: application/json
baseUri: https://checkout.{region}.commercetools.com
(annotations.sdkBaseUri): https://checkout.europe-west1.gcp.commercetools.com
baseUriParameters:
  region:
    type: string
    enum:
      - europe-west1.gcp
      - eu-central-1.aws
      - us-central1.gcp
      - us-east-2.aws
      - australia-southeast1.gcp
    description: |
      [Region](ctp:checkout:type:Region) in which the Checkout application is [hosted](/hosts-and-authorization).
(annotations.serviceRegions):
  - uri: https://checkout.europe-west1.gcp.commercetools.com
    region: europe-west1
    provider: gcp
    name: Europe (Google Cloud, Belgium)
  - uri: https://checkout.eu-central-1.aws.commercetools.com
    region: eu-central-1
    provider: aws
    name: Europe (AWS, Frankfurt)
  - uri: https://checkout.us-central1.gcp.commercetools.com
    region: us-central1
    provider: gcp
    name: North America (Google Cloud, Iowa)
  - uri: https://checkout.us-east-2.aws.commercetools.com
    region: us-east-2
    provider: aws
    name: North America (AWS, Ohio)
  - uri: https://checkout.australia-southeast1.gcp.commercetools.com
    region: australia-southeast1
    provider: gcp
    name: Australia (Google Cloud, Sydney)

types: !include types/types.raml

securitySchemes:
  oauth_2_0: !include security-schemes/oauth2.raml
securedBy: [oauth_2_0]

traits:
  secured_by_manage_payments:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'manage_checkout_payment_intents:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_manage_transactions:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'manage_checkout_transactions:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_view_transactions:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'view_checkout_transactions:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_view_payment_integrations:
    securedBy:
      [
        oauth_2_0:
          { scopes: ['view_checkout_payment_integrations:{projectKey}'] },
      ]
  secured_by_manage_payment_integrations:
    securedBy:
      [
        oauth_2_0:
          { scopes: ['manage_checkout_payment_integrations:{projectKey}'] },
      ]
  secured_by_view_applications:
    securedBy:
      [oauth_2_0: { scopes: ['view_checkout_applications:{projectKey}'] }]
  secured_by_manage_applications:
    securedBy:
      [oauth_2_0: { scopes: ['manage_checkout_applications:{projectKey}'] }]
  secured_by_manage_recurring_payment_jobs:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'manage_recurring_payment_jobs:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_view_recurring_payment_jobs:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'view_recurring_payment_jobs:{projectKey}',
                'manage_recurring_payment_jobs:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_manage_recurring_payments:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'manage_recurring_payments:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]
  secured_by_view_recurring_payments:
    securedBy:
      [
        oauth_2_0:
          {
            scopes:
              [
                'view_recurring_payments:{projectKey}',
                'manage_recurring_payments:{projectKey}',
                'manage_projects:{projectKey}',
              ],
          },
      ]

/{projectKey}:
  (annotations.methodName): withProjectKey
  uriParameters:
    projectKey:
      type: string
      description: Identifier of your Checkout entity and `key` of your [Project](ctp:api:type:Project).
  displayName: Project
  /payment-intents:
    displayName: Payment Intents
    /{paymentId}:
      (annotations.methodName): withPaymentId
      uriParameters:
        paymentId:
          type: string
          description: |
            `id` of the [Payment](ctp:api:type:Payment).
      post:
        displayName: Manage Payment by ID
        is:
          - secured_by_manage_payments
        body:
          type: PaymentIntent
          example: !include ./examples/payments/capturePayment.json
        description: |
          Requests to the payment [Connector](/checkout/connectors-and-applications#payment-connectors) time out after 30 seconds.

          Specific Error Codes:
          - [MultipleActionsNotAllowed](ctp:checkout:type:MultipleActionsNotAllowedError)
          - [RequiredField](ctp:checkout:type:RequiredFieldError)
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConnectorTimeout](ctp:checkout:type:ConnectorTimeoutError)
        responses:
          200:
            body:
              type: PaymentIntentResponse
              example: !include ../checkout/examples/payments/capturePaymentResponse.json
          400:
            description: The request was invalid.
            body:
              type: ErrorResponse
          504:
            description: The Connector did not respond within the configured timeout.
            body:
              type: ErrorResponse
  /transactions:
    displayName: Transactions
    post:
      displayName: Create Transaction
      is:
        - secured_by_manage_transactions
      body:
        type: TransactionDraft
        example: !include ./examples/transactions/transactionDraft.json
      description: |
        Creates a Transaction on Checkout. Requests to the payment [Connector](/checkout/connectors-and-applications#payment-connectors) time out after 30 seconds.

        Specific Error Codes:
        - [InvalidInput](ctp:checkout:type:InvalidInputError)
        - [InternalConstraintViolated](ctp:checkout:type:InternalConstraintViolatedError)
        - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
        - [ConnectorFailed](ctp:checkout:type:ConnectorFailedError)
        - [ConnectorTimeout](ctp:checkout:type:ConnectorTimeoutError)
        - [PaymentFailure](ctp:checkout:type:PaymentFailureError)
        - [RequiredField](ctp:checkout:type:RequiredFieldError)
      responses:
        201:
          body:
            type: Transaction
            example: !include ../checkout/examples/transactions/transaction.json
        400:
          description: The request was invalid.
          body:
            type: ErrorResponse
        504:
          description: The Connector did not respond within the configured timeout.
          body:
            type: ErrorResponse
    /{id}:
      (annotations.methodName): withId
      uriParameters:
        id:
          type: string
          description: |
            `id` of the [Transaction](ctp:checkout:type:Transaction).
      get:
        displayName: Get Transaction by ID
        is:
          - secured_by_view_transactions
        description: |
          Returns a Transaction with a given `id`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: Transaction
              example: !include ../checkout/examples/transactions/transaction.json
          400:
            description: The request was invalid.
            body:
              type: ErrorResponse
    /key={key}:
      (annotations.methodName): withKey
      uriParameters:
        key:
          type: string
          description: |
            `key` of the [Transaction](ctp:checkout:type:Transaction).
      get:
        displayName: Get Transaction by Key
        is:
          - secured_by_view_transactions
        description: |
          Returns a Transaction with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: Transaction
              example: !include ../checkout/examples/transactions/transaction.json
          400:
            description: The request was invalid.
            body:
              type: ErrorResponse
  /recurring-payment-jobs:
    displayName: Recurring Payment Jobs
    get:
      displayName: Query Recurring Payment Jobs
      is:
        - secured_by_view_recurring_payment_jobs
      description: |
        Retrieves Recurring Payment Jobs in a [Project](ctp:api:type:Project).

        The results are [paginated](/api/general-concepts#pagination).
      queryParameters:
        sort?:
          type: array
          items: string
          description: |
            Controls [Sorting](/api/general-concepts#sorting) of query results. The following fields are available for sorting: `id`, `key`, `createdAt`, `lastModifiedAt`.
          example: ['createdAt asc', 'id desc']
        limit?:
          type: integer
          format: int32
          description: |
            Number of results requested.
          default: 20
          minimum: 0
          maximum: 500
        offset?:
          type: integer
          format: int32
          description: |
            Number of elements skipped.
          default: 0
          maximum: 10000
        withTotal?:
          type: boolean
          default: false
          description: |
            Controls the calculation of the total number of query results.
        status.state?:
          type: string
          description: |
            Filters the results by `status.state` using the format `status.state=eq:{value}`.
          example: eq:Failed
      responses:
        200:
          body:
            type: PaginatedRecurringPaymentJob
            example: !include examples/recurring-payment-jobs/PaginatedRecurringPaymentJob.json
    post:
      displayName: Create Recurring Payment Job
      is:
        - secured_by_manage_recurring_payment_jobs
      description: |
        Creates a new [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob). Specific Error Codes:
        - [InvalidInput](ctp:checkout:type:InvalidInputError)
        - [ReferencedResourceNotFound](ctp:checkout:type:ReferencedResourceNotFoundError)
        - [RequiredField](ctp:checkout:type:RequiredFieldError)
      body:
        type: RecurringPaymentJobDraft
        example: !include examples/recurring-payment-jobs/RecurringPaymentJobDraft.json
      responses:
        201:
          body:
            type: RecurringPaymentJob
            example: !include examples/recurring-payment-jobs/RecurringPaymentJob.json
        400:
          description: The request was invalid.
          body:
            type: ErrorResponse
    /{id}:
      (annotations.methodName): withId
      uriParameters:
        id:
          type: string
          description: |
            `id` of the [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob).
      get:
        displayName: Get Recurring Payment Job by ID
        is:
          - secured_by_view_recurring_payment_jobs
        description: |
          Retrieves a Recurring Payment Job with a given `id`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: RecurringPaymentJob
              example: !include examples/recurring-payment-jobs/RecurringPaymentJob.json
      delete:
        displayName: Delete Recurring Payment Job by ID
        is:
          - secured_by_manage_recurring_payment_jobs
        description: |
          Deletes a Recurring Payment Job with a given `id`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: RecurringPaymentJob
              example: !include examples/recurring-payment-jobs/RecurringPaymentJob.json
    /key={key}:
      (annotations.methodName): withKey
      uriParameters:
        key:
          type: string
          description: |
            `key` of the [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob).
      get:
        displayName: Get Recurring Payment Job by Key
        is:
          - secured_by_view_recurring_payment_jobs
        description: |
          Retrieves a Recurring Payment Job with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: RecurringPaymentJob
              example: !include examples/recurring-payment-jobs/RecurringPaymentJob.json
      delete:
        displayName: Delete Recurring Payment Job by Key
        is:
          - secured_by_manage_recurring_payment_jobs
        description: |
          Deletes a Recurring Payment Job with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: RecurringPaymentJob
              example: !include examples/recurring-payment-jobs/RecurringPaymentJob.json
  /recurring-payments:
    displayName: Recurring Payments
    get:
      displayName: Query Recurring Payments
      is:
        - secured_by_view_recurring_payments
      description: |
        Retrieves Recurring Payments in a [Project](ctp:api:type:Project).

        The results are [paginated](/api/general-concepts#pagination).
      queryParameters:
        sort?:
          type: array
          items: string
          description: |
            Controls [Sorting](/api/general-concepts#sorting) of query results. The following fields are available for sorting: `id`, `key`, `createdAt`, `lastModifiedAt`.
          example: ['createdAt asc', 'id desc']
        limit?:
          type: integer
          format: int32
          description: |
            Number of results requested.
          default: 20
          minimum: 0
          maximum: 500
        offset?:
          type: integer
          format: int32
          description: |
            Number of elements skipped.
          default: 0
          maximum: 10000
        withTotal?:
          type: boolean
          default: false
          description: |
            Controls the calculation of the total number of query results.
        recurringOrderId?:
          type: string
          description: |
            Filters the results by the `id` of the [RecurringOrder](ctp:api:type:RecurringOrder) using the format `recurringOrderId=eq:{value}`.
          example: eq:39ccda28-47f9-41bf-8dde-e1d720c19000
      responses:
        200:
          body:
            type: PaginatedRecurringPayment
            example: !include examples/recurring-payments/PaginatedRecurringPayment.json
    post:
      displayName: Create Recurring Payment
      is:
        - secured_by_manage_recurring_payments
      description: |
        Creates a new [RecurringPayment](ctp:checkout:type:RecurringPayment). Specific Error Codes:
        - [InvalidInput](ctp:checkout:type:InvalidInputError)
        - [ReferencedResourceNotFound](ctp:checkout:type:ReferencedResourceNotFoundError)
        - [RequiredField](ctp:checkout:type:RequiredFieldError)
      body:
        type: RecurringPaymentDraft
        example: !include examples/recurring-payments/RecurringPaymentDraft.json
      responses:
        201:
          body:
            type: RecurringPayment
            example: !include examples/recurring-payments/RecurringPayment.json
        400:
          description: The request was invalid.
          body:
            type: ErrorResponse
    /{id}:
      (annotations.methodName): withId
      uriParameters:
        id:
          type: string
          description: |
            `id` of the [RecurringPayment](ctp:checkout:type:RecurringPayment).
      get:
        displayName: Get Recurring Payment by ID
        is:
          - secured_by_view_recurring_payments
        description: |
          Retrieves a Recurring Payment with a given `id`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
      post:
        displayName: Update Recurring Payment by ID
        is:
          - secured_by_manage_recurring_payments
        description: |
          Updates a Recurring Payment with a given `id`. Specific Error Codes:
          - [InvalidInput](ctp:checkout:type:InvalidInputError)
          - [ReferencedResourceNotFound](ctp:checkout:type:ReferencedResourceNotFoundError)
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        body:
          type: RecurringPaymentUpdateActions
          example: !include examples/recurring-payments/RecurringPaymentUpdateActions.json
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
          400:
            description: The request was invalid.
            body:
              type: ErrorResponse
      delete:
        displayName: Delete Recurring Payment by ID
        is:
          - secured_by_manage_recurring_payments
        description: |
          Deletes a Recurring Payment with a given `id`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
    /key={key}:
      (annotations.methodName): withKey
      uriParameters:
        key:
          type: string
          description: |
            `key` of the [RecurringPayment](ctp:checkout:type:RecurringPayment).
      get:
        displayName: Get Recurring Payment by Key
        is:
          - secured_by_view_recurring_payments
        description: |
          Retrieves a Recurring Payment with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
      post:
        displayName: Update Recurring Payment by Key
        is:
          - secured_by_manage_recurring_payments
        description: |
          Updates a Recurring Payment with a given `key`. Specific Error Codes:
          - [InvalidInput](ctp:checkout:type:InvalidInputError)
          - [ReferencedResourceNotFound](ctp:checkout:type:ReferencedResourceNotFoundError)
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        body:
          type: RecurringPaymentUpdateActions
          example: !include examples/recurring-payments/RecurringPaymentUpdateActions.json
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
          400:
            description: The request was invalid.
            body:
              type: ErrorResponse
      delete:
        displayName: Delete Recurring Payment by Key
        is:
          - secured_by_manage_recurring_payments
        description: |
          Deletes a Recurring Payment with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [ConcurrentModification](ctp:checkout:type:ConcurrentModificationError)
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: RecurringPayment
              example: !include examples/recurring-payments/RecurringPayment.json
  /payment-integrations:
    get:
      displayName: Query Payment Integrations
      is:
        - secured_by_view_payment_integrations
      description: |
        Retrieves Payment Integrations in a [Project](ctp:api:type:Project).

        The results are [paginated](/api/general-concepts#pagination).
      queryParameters:
        sort?:
          type: string[]
          description: |
            Controls [Sorting](/general-concepts#sorting) of query results.
          example: ['createdAt asc', 'name desc']
        limit?:
          type: integer
          format: int32
          description: |
            Number of results requested.
          default: 20
          minimum: 0
          maximum: 500
        offset?:
          type: integer
          format: int32
          description: |
            Number of elements skipped.
          default: 0
          maximum: 10000
        withTotal?:
          type: boolean
          default: true
          description: |
            Controls the calculation of the total number of query results.
      responses:
        200:
          body:
            type: PaginatedPaymentIntegration
            example: !include ../checkout/examples/payment-integrations/paginatedPaymentIntegrations.json
    post:
      displayName: Create Payment Integration
      is:
        - secured_by_manage_payment_integrations
      description: |
        Creates a new PaymentIntegration.
      body:
        type: PaymentIntegrationDraft
        example: !include ../checkout/examples/payment-integrations/paymentIntegrationDraft.json
      responses:
        201:
          body:
            type: PaymentIntegration
            example: !include ../checkout/examples/payment-integrations/paymentIntegration.json

        400:
          description: The request was invalid.
          body:
            type: ErrorResponse
    /{id}:
      (annotations.methodName): withId
      uriParameters:
        id:
          type: string
          description: |
            `id` of the [PaymentIntegration](ctp:checkout:type:PaymentIntegration).
      get:
        displayName: Get Payment Integration by ID
        is:
          - secured_by_view_payment_integrations
        description: |
          Retrieves Payment Integrations in a [Project](ctp:api:type:Project) with a given `id`.
        responses:
          200:
            body:
              type: PaymentIntegration
              example: !include ../checkout/examples/payment-integrations/paymentIntegration.json

      head:
        displayName: Check Payment Integration by ID
        is:
          - secured_by_view_payment_integrations
        description: |
          Checks if a PaymentIntegration with a given `id` exists. Returns `200 OK` if the PaymentIntegration exists, or `404 Not Found` if it doesn't. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            description: PaymentIntegration exists
      post:
        displayName: Update Payment Integration by ID
        is:
          - secured_by_manage_payment_integrations
        body:
          type: PaymentIntegrationUpdateActions
          example: !include examples/payment-integrations/paymentIntegrationUpdateActions.json
        responses:
          200:
            body:
              type: PaymentIntegration
      delete:
        displayName: Delete Payment Integration by ID
        is:
          - secured_by_manage_payment_integrations
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: PaymentIntegration
    /key={key}:
      (annotations.methodName): withKey
      uriParameters:
        key:
          type: string
          description: |
            `key` of the [PaymentIntegration](ctp:checkout:type:PaymentIntegration).
      get:
        displayName: Get Payment Integration by Key
        is:
          - secured_by_view_payment_integrations
        description: |
          Retrieves Payment Integrations in a [Project](ctp:api:type:Project) with a given `key`. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            body:
              type: PaymentIntegration
              example: !include ../checkout/examples/payment-integrations/paymentIntegration.json

      post:
        displayName: Update Payment Integration by Key
        is:
          - secured_by_manage_payment_integrations
        body:
          type: PaymentIntegrationUpdateActions
        responses:
          200:
            body:
              type: PaymentIntegration
      head:
        displayName: Check Payment Integration by Key
        is:
          - secured_by_view_payment_integrations
        description: |
          Checks if a PaymentIntegration with a given `key` exists. Returns `200 OK` if the PaymentIntegration exists, or `404 Not Found` if it doesn't. Specific Error Codes:
          - [ResourceNotFound](ctp:checkout:type:ResourceNotFoundError)
          - [GeneralError](ctp:checkout:type:GeneralError)
        responses:
          200:
            description: PaymentIntegration exists
      delete:
        displayName: Delete Payment Integration by Key
        is:
          - secured_by_manage_payment_integrations
        queryParameters:
          version:
            type: integer
            format: int64
            description: Last seen version of the resource.
        responses:
          200:
            body:
              type: PaymentIntegration
  /applications:
    get:
      displayName: Query Applications
      is:
        - secured_by_view_applications
      description: |
        Retrieves Applications
      queryParameters:
        sort?:
          type: string[]
          description: |
            Controls [Sorting](/general-concepts#sorting) of query results.
          example: ['createdAt asc', 'name desc']
        limit?:
          type: integer
          format: int32
          description: |
            Number of results requested.
          default: 20
          minimum: 0
          maximum: 500
        offset?:
          type: integer
          format: int32
          description: |
            Number of elements skipped.
          default: 0
          maximum: 10000
        withTotal?:
          type: boolean
          default: true
          description: |
            Controls the calculation of the total number of query results.
      responses:
        200:
          body:
            type: PaginatedApplication
            example: !include examples/applications/paginatedApplications.json
    post:
      displayName: Create Application
      is:
        - secured_by_manage_applications
      description: |
        Creates a new [Application](ctp:checkout:type:Application).
      body:
        type: ApplicationDraft
        example: !include examples/applications/CompleteFlowApplicationDraft.json

      responses:
        201:
          body:
            type: Application
            example: !include examples/applications/CompleteFlowApplication.json

        400:
          description: The request was invalid.
          body:
            type: ErrorResponse
    /{id}:
