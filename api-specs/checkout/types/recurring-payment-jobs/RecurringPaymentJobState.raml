#%RAML 1.0 DataType
(annotations.package): RecurringPaymentJob
(annotations.beta): true
displayName: RecurringPaymentJobState
description: |
  The state of the [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob).
enum:
  - Initial
  - Pending
  - Completed
  - Failed
(annotations.enumDescriptions):
  Initial: |
    The Recurring Payment Job has been created and is waiting to be processed.
  Pending: |
    Checkout is setting up the future payment method and [Connector](/checkout/connectors-and-applications#payment-connectors) for the Orders generated by the Recurring Order.
  Completed: |
    The Recurring Payment Job completed successfully. Checkout created the [Recurring Payment](ctp:checkout:type:RecurringPayment) needed to process the future payments of the Recurring Order.
  Failed: |
    The Recurring Payment Job failed.
