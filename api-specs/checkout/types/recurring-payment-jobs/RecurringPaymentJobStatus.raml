#%RAML 1.0 DataType
(annotations.package): RecurringPaymentJob
(annotations.beta): true
type: object
description: |
  The state of the [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob), the number of processing attempts, and the related errors in case of a failed Recurring Payment Job.
displayName: RecurringPaymentJobStatus
properties:
  state:
    type: RecurringPaymentJobState
    description: State of the Recurring Payment Job.
  attempts?:
    type: integer
    description: |
      Number of times Checkout has attempted to process the Recurring Payment Job.
  errors?:
    type: array
    items: RecurringPaymentJobError
    description: Errors returned if the Recurring Payment Job is in the `Failed` state.
