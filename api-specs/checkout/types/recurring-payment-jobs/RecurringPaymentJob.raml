#%RAML 1.0 DataType
(annotations.package): RecurringPaymentJob
(annotations.beta): true
type: object
displayName: RecurringPaymentJob
description: |
  Links a [Payment](ctp:api:type:Payment) made through Checkout to the [PaymentMethod](ctp:api:type:PaymentMethod) that must be used to pay the Orders generated by the resulting [Recurring Order](/api/projects/recurring-orders).
properties:
  id:
    type: string
    description: Unique identifier of the Recurring Payment Job.
  version:
    type: integer
    description: Current version of the Recurring Payment Job.
  key?:
    type: string
    description: User-defined unique identifier of the Recurring Payment Job.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
  originPayment:
    type: PaymentReference
    description: |
      [Payment](ctp:api:type:Payment) made for the Cart that generated the [Recurring Order](/api/projects/recurring-orders).
  paymentMethod:
    type: PaymentMethodReference
    description: |
      [PaymentMethod](ctp:api:type:PaymentMethod) that must be used to pay the Orders generated by the Recurring Order.
  recurringPayments?:
    type: array
    items: RecurringPaymentReference
    description: |
      [Recurring Payments](ctp:checkout:type:RecurringPayment) created from the Recurring Payment Job.
  status:
    type: RecurringPaymentJobStatus
    description: Status of the Recurring Payment Job.
  createdAt:
    type: datetime
    description: Date and time (UTC) the Recurring Payment Job was initially created.
  lastModifiedAt:
    type: datetime
    description: Date and time (UTC) the Recurring Payment Job was last updated.
