#%RAML 1.0 DataType
(annotations.package): RecurringPaymentJob
(annotations.beta): true
type: object
displayName: RecurringPaymentJobDraft
description: |
  Draft type to create a [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob).
properties:
  key?:
    type: string
    description: User-defined unique identifier of the Recurring Payment Job.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
  originPayment:
    type: PaymentReference
    description: |
      [Payment](ctp:api:type:Payment) made for the Cart that generates the [Recurring Order](/api/projects/recurring-orders).
  paymentMethod:
    type: PaymentMethodReference
    description: |
      [PaymentMethod](ctp:api:type:PaymentMethod) that must be used to pay the Orders generated by the Recurring Order.
