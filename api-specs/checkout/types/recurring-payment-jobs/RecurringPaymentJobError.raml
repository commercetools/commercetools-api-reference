#%RAML 1.0 DataType
(annotations.package): RecurringPaymentJob
(annotations.beta): true
type: object
displayName: RecurringPaymentJobError
description: |
  A single error on the [RecurringPaymentJob](ctp:checkout:type:RecurringPaymentJob). Multiple errors may be included in the [RecurringPaymentJobStatus](ctp:checkout:type:RecurringPaymentJobStatus).
properties:
  code:
    type: string
    description: |
      Error identifier.
  message:
    type: string
    description: |
      Plain text description of the cause of the error.
