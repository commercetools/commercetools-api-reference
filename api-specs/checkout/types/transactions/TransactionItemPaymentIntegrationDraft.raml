#%RAML 1.0 DataType
(annotations.package): Transaction
(annotations.beta): true
(annotations.ignoreValidators): [DiscriminatedSubtypeRule]
type: TransactionItemDraft
displayName: TransactionItemPaymentIntegrationDraft
description: |
  Creates a Transaction Item that is processed through a [Payment Integration](/checkout/connectors-and-applications#payment-integrations). This is the default Transaction Item type used when `type` is omitted.
properties:
  type?:
    type: string
    description: |
      Must not be set for TransactionItemPaymentIntegrationDraft.
  paymentIntegration:
    type: PaymentIntegrationResourceIdentifier
    description: Resource Identifier of the [Payment Integration](/checkout/connectors-and-applications#payment-integrations) to use to execute the payment.
