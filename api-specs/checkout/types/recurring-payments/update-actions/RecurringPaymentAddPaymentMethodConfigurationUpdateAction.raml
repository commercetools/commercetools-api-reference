#%RAML 1.0 DataType
(annotations.package): RecurringPayment
(annotations.beta): true
type: RecurringPaymentUpdateAction
displayName: RecurringPaymentAddPaymentMethodConfigurationUpdateAction
discriminatorValue: addPaymentMethodConfiguration
description: |
  Adds a PaymentMethodConfiguration to a RecurringPayment. Checkout only supports processing a RecurringPayment with one PaymentMethodConfiguration.
properties:
  paymentMethodConfiguration:
    type: PaymentMethodConfiguration
    description: |
      PaymentMethod and Connector to add.
