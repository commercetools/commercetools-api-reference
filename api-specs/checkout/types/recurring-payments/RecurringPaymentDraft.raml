#%RAML 1.0 DataType
(annotations.package): RecurringPayment
(annotations.beta): true
type: object
displayName: RecurringPaymentDraft
description: |
  Draft type to create a [RecurringPayment](ctp:checkout:type:RecurringPayment).
properties:
  key?:
    type: string
    description: User-defined unique identifier of the RecurringPayment.
    pattern: ^[A-Za-z0-9_-]+$
    minLength: 2
    maxLength: 256
  recurringOrder:
    type: RecurringOrderReference
    description: |
      [RecurringOrder](ctp:api:type:RecurringOrder) whose future payments must be processed using Checkout.
  paymentMethodConfigurations:
    type: array
    items: PaymentMethodConfiguration
    description: |
      PaymentMethod and Connector to use to pay the [RecurringOrder](ctp:api:type:RecurringOrder). Checkout only supports processing this array with one PaymentMethodConfiguration.
    minItems: 1
